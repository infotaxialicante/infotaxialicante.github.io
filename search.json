[
{% assign posts = site.posts %}
{% for post in posts %}
  {
    "title": {{ post.title | jsonify }},
    "search": {% if post.search %}{{ post.search | jsonify }}{% else %}[]{% endif %},
    "lang": {{ post.lang | jsonify }},
    "permalink": {{ post.url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]